<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/gradient_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackJoin"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_back"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="JOIN ROOM"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View android:layout_width="44dp" android:layout_height="44dp" />
        </LinearLayout>

        <!-- Form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Your Name"
                android:textColor="@color/neon_pink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/etJoinUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/game_input"
                android:hint="Enter your name"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="@color/text_tertiary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="Room Code"
                android:textColor="@color/neon_pink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/etRoomCode"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/game_input"
                android:gravity="center"
                android:hint="Enter room code"
                android:inputType="textCapCharacters"
                android:letterSpacing="0.2"
                android:paddingHorizontal="16dp"
                android:textColor="@color/neon_cyan"
                android:textColorHint="@color/text_tertiary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbJoinEmulatorHost"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:checked="false"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnJoinRoomNow"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/btn_teal"
                    android:stateListAnimator="@null"
                    android:text="JOIN ROOM"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <ProgressBar
                    android:id="@+id/progressJoin"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/tvJoinStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_room_input"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="Status: idle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
