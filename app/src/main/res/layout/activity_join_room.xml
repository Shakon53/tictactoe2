<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBackJoin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_back"
                android:stateListAnimator="@null"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:padding="0dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="JOIN ROOM"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <View android:layout_width="48dp" android:layout_height="48dp" />
        </LinearLayout>

        <!-- Form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/game_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Name"
                android:textColor="#8B96B0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etJoinUsername"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/game_input"
                android:hint="Enter your name"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A5568"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Room Code"
                android:textColor="#8B96B0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etRoomCode"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/game_input"
                android:hint="Enter room code"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="16dp"
                android:textColor="#A855F7"
                android:textColorHint="#4A5568"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.2" />

            <!-- Hidden checkbox for code compat -->
            <CheckBox
                android:id="@+id/cbJoinEmulatorHost"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:checked="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btnJoinRoomNow"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/gold_button"
                    android:stateListAnimator="@null"
                    android:text="JOIN ROOM"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressJoin"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/tvJoinStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:background="@drawable/game_input"
            android:text="Status: idle"
            android:textColor="#8B96B0"
            android:textSize="15sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
