<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/gradient_bg_main">

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/bg_blob_purple"
        android:alpha="0.4" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-40dp"
        android:background="@drawable/bg_blob_blue"
        android:alpha="0.3" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btnSupportBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_back"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="ПОДДЕРЖКА"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View android:layout_width="44dp" android:layout_height="44dp" />
        </LinearLayout>

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <!-- Header card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_floating_o"
                        android:backgroundTint="#338B5CF6"
                        android:gravity="center"
                        android:text="&#9993;"
                        android:textSize="26sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Связаться с нами"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Обращения рассматриваются администратором"
                            android:textColor="#8A80AA"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Form card -->
                <LinearLayout
                    android:id="@+id/layoutSupportForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Username (auto-filled, read-only display) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ОТ КОГО"
                        android:textColor="#6A6080"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_glass_card"
                        android:backgroundTint="#1AFFFFFF"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvSupportUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#CCCCCC"
                            android:textSize="14sp"
                            android:text="Player" />
                    </LinearLayout>

                    <!-- Category -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="КАТЕГОРИЯ"
                        android:textColor="#6A6080"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/categoryGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/catBug"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_difficulty_normal"
                            android:gravity="center"
                            android:text="🐛 Баг"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/catSupport"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_difficulty_normal"
                            android:gravity="center"
                            android:text="💬 Помощь"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/catCheat"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_difficulty_normal"
                            android:gravity="center"
                            android:text="⚠️ Читер"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/catOther"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_difficulty_normal"
                            android:gravity="center"
                            android:text="📋 Другое"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Subject -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ТЕМА"
                        android:textColor="#6A6080"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etSupportSubject"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/game_input"
                        android:hint="Кратко опиши проблему"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A4060"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Message -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="СООБЩЕНИЕ"
                        android:textColor="#6A6080"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etSupportMessage"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/game_input"
                        android:gravity="top|start"
                        android:hint="Подробно опиши ситуацию…"
                        android:inputType="textMultiLine"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A4060"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp" />

                    <!-- Submit button -->
                    <Button
                        android:id="@+id/btnSupportSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/btn_primary_purple"
                        android:stateListAnimator="@null"
                        android:text="Отправить обращение"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Success state (hidden by default) -->
                <LinearLayout
                    android:id="@+id/layoutSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="36dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅"
                        android:textSize="52sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Обращение отправлено!"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Администратор рассмотрит его в ближайшее время"
                        android:textColor="#8A80AA"
                        android:textSize="13sp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btnSupportClose"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_difficulty_normal"
                        android:paddingHorizontal="32dp"
                        android:stateListAnimator="@null"
                        android:text="Готово"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
