<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:background="@drawable/player_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDialogSound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sound"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:thumbTint="@color/difficulty_normal" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDialogBgm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BGM"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:thumbTint="@color/difficulty_normal" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDialogVibration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vibration"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:thumbTint="@color/difficulty_normal" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDialogReplay"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_teal"
        android:stateListAnimator="@null"
        android:text="Replay"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnDialogHome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_orange"
        android:stateListAnimator="@null"
        android:text="Home"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
