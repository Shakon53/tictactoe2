<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:fitsSystemWindows="true">

    <!-- Blob decorations -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_blob_purple"
        android:alpha="0.3"
        android:translationX="80dp"
        android:translationY="-50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_blob_blue"
        android:alpha="0.2"
        android:translationX="-50dp"
        android:translationY="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Top bar ── -->
    <LinearLayout
        android:id="@+id/topBarSudoku"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnSudokuBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_back"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="&#8592;"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSudokuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sudoku"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvSudokuTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/neon_orange"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Difficulty picker buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSudokuEasy"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_primary_lime"
                android:stateListAnimator="@null"
                android:text="Easy"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSudokuMedium"
                android:layout_width="58dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_orange"
                android:stateListAnimator="@null"
                android:text="Med"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSudokuHard"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_primary_pink"
                android:stateListAnimator="@null"
                android:text="Hard"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── Sudoku grid (square via ratio) ── -->
    <FrameLayout
        android:id="@+id/sudokuBoardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_card"
        android:padding="4dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarSudoku"
        app:layout_constraintBottom_toTopOf="@id/numPad"
        app:layout_constraintVertical_bias="0.0">

        <GridLayout
            android:id="@+id/gridSudoku"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="9"
            android:rowCount="9"
            android:background="#1A1A2E"
            android:padding="3dp" />

    </FrameLayout>

    <!-- ── Number pad ── -->
    <LinearLayout
        android:id="@+id/numPad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnSudoku1"
            style="@style/SudokuNumBtn"
            android:text="1" />
        <Button
            android:id="@+id/btnSudoku2"
            style="@style/SudokuNumBtn"
            android:text="2" />
        <Button
            android:id="@+id/btnSudoku3"
            style="@style/SudokuNumBtn"
            android:text="3" />
        <Button
            android:id="@+id/btnSudoku4"
            style="@style/SudokuNumBtn"
            android:text="4" />
        <Button
            android:id="@+id/btnSudoku5"
            style="@style/SudokuNumBtn"
            android:text="5" />
        <Button
            android:id="@+id/btnSudoku6"
            style="@style/SudokuNumBtn"
            android:text="6" />
        <Button
            android:id="@+id/btnSudoku7"
            style="@style/SudokuNumBtn"
            android:text="7" />
        <Button
            android:id="@+id/btnSudoku8"
            style="@style/SudokuNumBtn"
            android:text="8" />
        <Button
            android:id="@+id/btnSudoku9"
            style="@style/SudokuNumBtn"
            android:text="9" />
        <Button
            android:id="@+id/btnSudokuErase"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/btn_back"
            android:stateListAnimator="@null"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
