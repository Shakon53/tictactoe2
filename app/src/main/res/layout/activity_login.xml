<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/gradient_bg_main">

    <View android:layout_width="260dp" android:layout_height="260dp"
        android:layout_marginTop="-70dp" android:layout_marginEnd="-70dp"
        android:background="@drawable/bg_blob_purple" android:alpha="0.5"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <View android:layout_width="200dp" android:layout_height="200dp"
        android:layout_marginBottom="-50dp" android:layout_marginStart="-50dp"
        android:background="@drawable/bg_blob_blue" android:alpha="0.4"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/card_padding_h"
        android:paddingTop="@dimen/card_padding_v"
        android:paddingBottom="@dimen/card_padding_v"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:id="@+id/ivLoginLogo"
            android:layout_width="@dimen/login_logo_size"
            android:layout_height="@dimen/login_logo_size"
            android:src="@drawable/ic_game_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="TIC TAC TOE"
            android:textColor="#FFFFFF" android:textSize="@dimen/splash_title_size"
            android:textStyle="bold" android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="ONLINE"
            android:textColor="@color/neon_pink" android:textSize="@dimen/splash_subtitle_size"
            android:textStyle="bold" android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:layout_marginBottom="4dp"
            android:text="Welcome! Choose how to continue"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:gravity="center" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:layout_marginBottom="20dp"
            android:background="@color/glass_border" />

        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent" android:layout_height="@dimen/btn_height"
            android:background="@drawable/btn_google" android:stateListAnimator="@null"
            android:text="G   Continue with Google" android:textColor="#1F1F1F"
            android:textSize="@dimen/btn_text_size" android:textStyle="bold"
            android:letterSpacing="0.02" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/glass_border" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp" android:text="or"
                android:textColor="@color/text_tertiary" android:textSize="13sp" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/glass_border" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGuestPlay"
            android:layout_width="match_parent" android:layout_height="@dimen/btn_height"
            android:background="@drawable/btn_back" android:stateListAnimator="@null"
            android:text="Play as Guest" android:textColor="#FFFFFF"
            android:textSize="@dimen/btn_text_size" android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="Guest progress is saved locally only"
            android:textColor="@color/text_tertiary" android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" android:text="v2.4.1  •  Tic Tac Toe Online"
        android:textColor="@color/text_tertiary" android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
