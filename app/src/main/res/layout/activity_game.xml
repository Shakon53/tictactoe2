<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- Top bar: Back | Room Code | Spacer -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBackToMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_back"
            android:stateListAnimator="@null"
            android:text="&#8592;"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:padding="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Room code center -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROOM CODE"
                android:textColor="#4A5568"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:id="@+id/tvRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A855F7"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="1234" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Spacer matching back button width -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- Player VS Player panel -->
    <LinearLayout
        android:id="@+id/playerPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/game_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: YOU -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMySymbol"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:background="@drawable/game_card"
                tools:text="X"
                tools:textColor="#FBBF24" />

            <TextView
                android:id="@+id/tvMyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Player" />

            <TextView
                android:id="@+id/tvMyScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#4A5568"
                android:textSize="11sp"
                tools:text="0W  0L  0D" />
        </LinearLayout>

        <!-- VS divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="VS"
            android:textColor="#2D3A5C"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Right: OPPONENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvOppSymbol"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:background="@drawable/game_card"
                tools:text="O"
                tools:textColor="#38BDF8" />

            <TextView
                android:id="@+id/tvOppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Opponent" />

            <TextView
                android:id="@+id/tvOppScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#4A5568"
                android:textSize="11sp"
                tools:text="0W  0L  0D" />
        </LinearLayout>
    </LinearLayout>

    <!-- Turn status + timer row -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/playerPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:background="@drawable/game_card"
            android:textColor="#FBBF24"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            tools:text="Your Turn!" />

        <LinearLayout
            android:id="@+id/timerPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/game_card"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textColor="#FBBF24"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sec"
                android:textColor="#4A5568"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden compat fields (not visible, keep for legacy) -->
    <TextView
        android:id="@+id/tvPlayerYou"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPlayerBadge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Game board -->
    <LinearLayout
        android:id="@+id/gameBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/game_board_bg"
        android:padding="10dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="3"
            android:rowCount="3">

            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnWeight="1" android:layout_margin="5dp" android:background="@drawable/game_cell" android:stateListAnimator="@null" android:textSize="40sp" android:textStyle="bold" />

        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
