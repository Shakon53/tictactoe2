<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_back"
            android:stateListAnimator="@null"
            android:text="&#8592;"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:padding="0dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="vs AI"
            android:textColor="#FBBF24"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHardMedals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🏅 x0"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_back"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Player vs AI panel -->
    <LinearLayout
        android:id="@+id/playerPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/player_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: YOU -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMySymbol"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="@drawable/avatar_bg"
                tools:text="X"
                tools:textColor="#FBBF24" />

            <TextView
                android:id="@+id/tvMyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="You" />

            <TextView
                android:id="@+id/tvMyScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8B7CD0"
                android:textSize="11sp"
                tools:text="0W 0L 0D" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="VS"
            android:textColor="#4A3AA0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Right: AI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAiSymbol"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="@drawable/avatar_bg"
                tools:text="O"
                tools:textColor="#38BDF8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AI Bot"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8B7CD0"
                android:textSize="11sp"
                tools:text="0W 0L 0D" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/tvGameStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:background="@drawable/round_badge_bg"
        android:textColor="#FBBF24"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Your Turn!"
        app:layout_constraintTop_toBottomOf="@id/playerPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/difficultyPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/player_card_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGameStatus">

        <Button
            android:id="@+id/btnDifficultyEasy"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:background="@drawable/game_button"
            android:stateListAnimator="@null"
            android:text="Easy"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDifficultyNormal"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/game_button"
            android:stateListAnimator="@null"
            android:text="Normal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDifficultyHard"
            android:layout_width="88dp"
            android:layout_height="40dp"
            android:background="@drawable/game_button"
            android:stateListAnimator="@null"
            android:text="Hard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDifficultyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#C4B5FD"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/difficultyPanel"
        tools:text="Normal: balanced AI behavior" />

    <LinearLayout
        android:id="@+id/playerOptionsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDifficultyHint">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchPlayerFirst"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="You move first"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRematch"
            android:layout_width="118dp"
            android:layout_height="42dp"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:text="Rematch"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverallStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#DDD6FE"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerOptionsRow"
        tools:text="Rating: 420 | Winrate: 62% | Easy 8-1-1 | Normal 3-2-0 | Hard 1-4-0" />

    <!-- Board with grid LINES (no cell backgrounds) -->
    <LinearLayout
        android:id="@+id/gameBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOverallStats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Row 0 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#60FFFFFF" />
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#60FFFFFF" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#60FFFFFF" />

        <!-- Row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#60FFFFFF" />
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#60FFFFFF" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#60FFFFFF" />

        <!-- Row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#60FFFFFF" />
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#60FFFFFF" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/game_cell_transparent" android:stateListAnimator="@null" android:textSize="44sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
