<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/gradient_bg">

    <!-- Streak banner overlay -->
    <TextView
        android:id="@+id/tvStreakBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="150dp"
        android:background="@drawable/bg_streak_banner"
        android:elevation="10dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Background blob -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/bg_blob_purple"
        android:alpha="0.4" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== TOP BAR ===== -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back button -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_back"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <!-- Center title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SINGLE PLAYER"
                android:textColor="@color/neon_purple"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Hard medals (hidden visually but functional) -->
            <TextView
                android:id="@+id/tvHardMedals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/neon_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="🏅 x0" />

            <!-- Pause / quick settings button -->
            <Button
                android:id="@+id/btnQuickSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_back"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#9646;&#9646;"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ===== SCOREBOARD CARD ===== -->
        <LinearLayout
            android:id="@+id/playerPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <!-- LEFT: YOU (X) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- X badge -->
                <TextView
                    android:id="@+id/tvMySymbol"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_x_symbol"
                    android:gravity="center"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="X"
                    tools:textColor="#FFFFFF" />

                <!-- Wins count (big number) -->
                <TextView
                    android:id="@+id/tvMyScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FBCE5C"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="3" />

                <!-- L/D breakdown -->
                <TextView
                    android:id="@+id/tvMyStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:text="0L · 0D" />

                <TextView
                    android:id="@+id/tvMyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="YOU"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- CENTER: VS + Timer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCenterDiff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_room_input"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="NORMAL"
                    android:textColor="@color/difficulty_normal"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- RIGHT: CPU (O) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- O badge -->
                <TextView
                    android:id="@+id/tvAiSymbol"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_o_symbol"
                    android:gravity="center"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="O"
                    tools:textColor="#FFFFFF" />

                <!-- AI wins count -->
                <TextView
                    android:id="@+id/tvAiScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#38BDF8"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="1" />

                <!-- AI L/D breakdown -->
                <TextView
                    android:id="@+id/tvAiStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:text="0L · 0D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CPU"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

        </LinearLayout>

        <!-- ===== TURN INDICATOR ===== -->
        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_turn_indicator"
            android:gravity="center"
            android:paddingVertical="13dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            tools:text="YOUR TURN ☆"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playerPanel" />

        <!-- ===== GAME BOARD ===== -->
        <LinearLayout
            android:id="@+id/gameBoard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="10dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGameStatus"
            app:layout_constraintBottom_toTopOf="@id/difficultyPanel"
            app:layout_constraintVertical_bias="0.0">

            <GridLayout
                android:id="@+id/gameBoardGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="3"
                android:rowCount="3" />

        </LinearLayout>

        <!-- ===== DIFFICULTY SECTION ===== -->
        <LinearLayout
            android:id="@+id/difficultyPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gameBoard">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="DIFFICULTY"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDifficultyEasy"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_difficulty_easy"
                    android:stateListAnimator="@null"
                    android:text="EASY"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDifficultyNormal"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_difficulty_normal"
                    android:stateListAnimator="@null"
                    android:text="NORMAL"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDifficultyHard"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_difficulty_hard"
                    android:stateListAnimator="@null"
                    android:text="HARD"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- ===== BOTTOM BAR: Rematch + New Game ===== -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Rematch (shown after game ends) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRematch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_height"
                android:layout_marginEnd="10dp"
                android:background="@drawable/btn_back"
                android:paddingHorizontal="20dp"
                android:stateListAnimator="@null"
                android:text="⟳  REMATCH"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/btn_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@null"
                app:strokeWidth="0dp"
                app:cornerRadius="0dp"
                android:visibility="gone" />

            <!-- New Game -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewGame"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_weight="1"
                android:background="@drawable/btn_orange"
                android:stateListAnimator="@null"
                android:text="↺  NEW GAME"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/btn_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@null"
                app:strokeWidth="0dp"
                app:cornerRadius="0dp" />
        </LinearLayout>

        <!-- Hidden functional views (kept for Java compat) -->
        <TextView
            android:id="@+id/tvDifficultyHint"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOverallStats"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/playerOptionsRow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPlayerFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You move first"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
