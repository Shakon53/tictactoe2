<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed: flat, no 3D -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4C1D95" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#7C3AED"
                        android:endColor="#6D28D9"
                        android:angle="270" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal: 3D raised neon purple -->
    <item>
        <layer-list>
            <!-- Shadow / depth layer -->
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3B0764" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Top face gradient -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#A855F7"
                        android:endColor="#8B5CF6"
                        android:angle="270" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
