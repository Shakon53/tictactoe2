<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#059669" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#10B981"
                        android:endColor="#059669"
                        android:angle="270" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="7dp">
                <shape android:shape="rectangle">
                    <solid android:color="#065F46" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:bottom="7dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#34D399"
                        android:endColor="#10B981"
                        android:angle="270" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
