<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#12172B" />
                    <corners android:radius="20dp" />
                    <stroke android:width="2dp" android:color="#8B5CF6" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal: dark with purple border, 3D depth -->
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#0A0D1A" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Top face -->
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A1F35" />
                    <corners android:radius="20dp" />
                    <stroke android:width="2dp" android:color="#4B3F8A" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
