<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed: sunken dark -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#0D1525" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#243055" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.5dp" android:color="#8B5CF6" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal: 3D raised dark cell -->
    <item>
        <layer-list>
            <!-- Bottom shadow layer -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#080C18" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Top face with subtle gradient -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1E2845"
                        android:endColor="#182038"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.5dp" android:color="#2D3A5C" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
